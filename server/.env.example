# MongoDB Atlas connection string
# Get yours at: https://www.mongodb.com/atlas (free tier)
MONGODB_URI=mongodb+srv://your_username:your_password@your-cluster.xxxxx.mongodb.net/mo-db?retryWrites=true&w=majority

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/apikey (free)
GEMINI_API_KEY=your_gemini_api_key_here

# Server port
PORT=5000
